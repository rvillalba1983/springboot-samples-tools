<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath />
	</parent>

	<groupId>com.rvillalba</groupId>
	<artifactId>springboot-samples-tools</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>springboot-samples-tools</name>
	<description>Ejemplos de funcionalidades de Spring Boot, uno por módulo</description>

	<modules>
		<module>spring-async</module>
		<module>spring-caching</module>
		<module>spring-internationalization</module>
		<module>spring-mail</module>
		<module>spring-boot-admin</module>
		<module>spring-oauth2-authorization-server</module>
		<module>spring-oauth2-resource-server</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<spring-boot-admin.version>4.1.4</spring-boot-admin.version>
		<greenmail.version>2.1.14</greenmail.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>de.codecentric</groupId>
				<artifactId>spring-boot-admin-dependencies</artifactId>
				<version>${spring-boot-admin.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.icegreen</groupId>
				<artifactId>greenmail-junit5</artifactId>
				<version>${greenmail.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Comunes a todos los módulos -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
